                "--fast"
            ],
            "problemMatcher": []
        },
        {
            "label": "Build",
            "type": "shell",
            "command": "blender",
            "args": [
                "--command",
                "extension",
                "build",
                "--source-dir",
                "${workspaceFolder}",
                "--output-dir",
                "${workspaceFolder}/..",
                "--split-platforms",
                "--verbose",
            ],
            "problemMatcher": []
        },
        {
            "label": "Print assets",
            "type": "shell",
            "command": ".vscode/launch_blender_with_script.bat",
            "args": [
                "--background",
