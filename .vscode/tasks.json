    "version": "2.0.0",
    "tasks": [
        {
            "label": "Update assets",
            "type": "shell",
            "command": ".vscode/launch_blender_with_script.bat",
            "args": [
                "--background",
                "C:/Users/romai/Documents/Projets/26 - Bezier Quest/SurfacePsycho/assets/assets.blend",
                "--python",
                ".vscode/update_asset_file.py"
            ],
            "problemMatcher": []
        },
        {
            "label": "Update assets FAST",
            "type": "shell",
            "command": ".vscode/launch_blender_with_script.bat",
            "args": [
                "--background",
                "C:/Users/romai/Documents/Projets/26 - Bezier Quest/SurfacePsycho/assets/assets.blend",
                "--python",
                ".vscode/update_asset_file.py",
