{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SurfacePsycho features table",
  "description": "Shape of docs/features_table.yaml and the values allowed in its catalog, tags and testing columns. VS Code reports violations inline through the yaml.schemas setting of .vscode/settings.json.",
  "type": "array",
  "items": {
    "$ref": "#/$defs/feature"
  },
  "$defs": {
    "id": {
      "description": "Node group name, prefixed with 'SP - '. It doubles as the asset name in Blender.",
      "type": "string",
      "pattern": "^SP.+$"
    },
    "catalog": {
      "description": "The single category the feature is filed under in the asset library. null means not filed yet.",
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "analyse",
        "blend & fill",
        "connect",
        "convert",
        "copy",
        "fillet",
        "project",
        "rebuild",
        "shape",
        "symmetry",
        "trim",
        "utility",
        null
      ]
    },
    "tags": {
      "description": "For the asset browser search",
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "analyse",
          "bezier",
          "compound",
          "connect",
          "convert",
          "copy",
          "curve",
          "fillet",
          "flat",
          "index",
          "meshing",
          "nurbs",
          "project",
          "rebuild",
          "select",
          "set property",
          "shape",
          "solid",
          "split",
          "surface",
          "revolution",
          "symmetry",
          "tool",
          "transform",
          "trim",
          "utility"
        ]
      }
    },
    "testing": {
      "description": "How much automated testing covers the feature",
      "type": "string",
      "enum": [
        "none",
        "light",
        "good"
      ]
    },
    "type": {
      "description": "feature type",
      "type": "string",
      "enum": [
        "modifier",
        "tool",
        "shape",
        "nodegroup",
        "operator"
      ]
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "catalog",
        "file",
        "type"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "catalog": {
          "$ref": "#/$defs/catalog"
        },
        "tags": {
          "$ref": "#/$defs/tags"
        },
        "testing": {
          "$ref": "#/$defs/testing"
        },
        "Comment": {
          "description": "Working note, typically a planned merge or rename. Omit the key when there is nothing to say.",
          "type": [
            "string",
            "null"
          ]
        },
        "icon filename": {
          "description": "File name in icons/, normally '<id>.png'.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\.png$"
        },
        "file": {
          "description": "Name of the .blend file at the quest folder top level owning the node group, or null when none does. Filled by .tooling/update_features_table.py.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^.+\\.blend$"
        },
        "type": {
          "$ref": "#/$defs/type"
        }
      }
    }
  }
}